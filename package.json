{
  "name": "@gino/host",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Gino host — protocol-v2 control plane (Bun + Hono + Drizzle on bun:sqlite).",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests eslint.config.ts drizzle.config.ts",
    "lint:fix": "eslint src scripts tests eslint.config.ts drizzle.config.ts --fix",
    "test": "bun --env-file=/dev/null test ./tests/",
    "test:coverage": "bun --env-file=/dev/null test ./tests/ --coverage",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "package": "bun scripts/package.ts",
    "clean": "bun scripts/clean.ts",
    "gen:frames-schema": "bun run scripts/gen-frames-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/standard-validator": "0.2.2",
    "@scalar/hono-api-reference": "0.11.5",
    "cac": "7.0.0",
    "consola": "3.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.26",
    "hono-openapi": "1.3.0",
    "nanoid": "5.1.15",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "eslint": "10.5.0",
    "jiti": "^2.7.0",
    "typescript": "6.0.3"
  }
}
