# Gino host configuration. Every host env var is GINO_-prefixed; the host is
# the sole config source (the agent never reads process env directly).
# See src/config/schema.ts for the validated surface.

# Runtime mode: development | production | test
NODE_ENV=development

# Transport — the single OpenAPIHono server.
GINO_PORT=3000
GINO_HOST=0.0.0.0
# URL prefix the host is mounted under (empty → API served at /api).
GINO_BASE_PATH=
# Application slug (lowercase letters, digits, dashes).
GINO_APP_NAME=gino
# Comma-separated CORS allow-list (empty → "*" in dev, same-origin in prod).
# GINO_CORS_ORIGIN=https://example.com

# Storage — bun:sqlite database file (relative paths resolve to the repo root).
GINO_DB_PATH=data/db/gino.db

# Auth (M1 / OD12) — three token kinds. REQUIRED for the agent + admin surfaces;
# an empty/unset value fails closed (the host rejects every guarded request).
#   register token  — shared bootstrap secret on POST /agent/register
#   channel token   — admin/user bearer on /admin/*
# The per-agent *connect* token is minted at register (not configured here).
GINO_REGISTER_TOKEN=change-me-register-secret
GINO_HTTP_CHANNEL_TOKEN=change-me-channel-secret

# Logging.
GINO_LOG_LEVEL=info
GINO_LOG_FILE=data/logs/gino.log
GINO_LOG_TO_STDOUT=false

# Proxy / client-IP resolution (only enable behind a sanitising proxy).
GINO_TRUST_PROXY=false
GINO_TRUSTED_PROXY_IPS=

# Edge rate limits (fixed window; keyed per verified principal, else per
# client IP). Defaults shown — generous enough for normal traffic while
# bounding brute force and runaway retry loops.
GINO_RATE_LIMIT_REGISTER_MAX=30
GINO_RATE_LIMIT_REGISTER_WINDOW_MS=60000
GINO_RATE_LIMIT_LLM_MAX=300
GINO_RATE_LIMIT_LLM_WINDOW_MS=60000
GINO_RATE_LIMIT_MESSAGES_MAX=300
GINO_RATE_LIMIT_MESSAGES_WINDOW_MS=60000

# Outbound webhook egress (M6). Per-request delivery timeout, bounded attempts
# before a persistently failing batch is skipped (dead-lettered), and the
# retry-tick cadence for failed/backlogged pushes. Defaults shown.
GINO_WEBHOOK_TIMEOUT_MS=10000
GINO_WEBHOOK_MAX_ATTEMPTS=5
GINO_WEBHOOK_RETRY_INTERVAL_MS=15000

# Credential proxy (M7, /llm/*). The host injects these real upstream
# credentials so the engine never sees them; the engine points
# ANTHROPIC_BASE_URL/OPENAI_BASE_URL at <hostUrl>/llm. All optional — unset
# means that provider is simply unconfigured. Per provider, the API key wins
# over the OAuth token.
GINO_PROXY_ANTHROPIC_BASE_URL=https://api.anthropic.com
GINO_PROXY_OPENAI_BASE_URL=https://api.openai.com
# GINO_PROXY_ANTHROPIC_API_KEY=sk-ant-...
# GINO_PROXY_ANTHROPIC_OAUTH_TOKEN=
# GINO_PROXY_OPENAI_API_KEY=sk-...
# GINO_PROXY_OPENAI_OAUTH_TOKEN=
# Codex (ChatGPT) OAuth refresh — set the refresh token to auto-refresh the
# access token; the account id is forwarded as chatgpt-account-id when present.
# GINO_PROXY_CODEX_REFRESH_TOKEN=
# GINO_PROXY_CODEX_ACCOUNT_ID=
# Static proxy credential (H5) — alternative to the per-agent connect token.
# GINO_PROXY_STATIC_KEY=
# model-map overrides (JSON; merged over the built-in alias map).
# GINO_PROXY_MODEL_MAP={"gpt-mini":{"provider":"openai","model":"gpt-5-codex-mini"}}
# Allow an upstream that resolves to a private IP (default false / fail closed).
GINO_PROXY_ALLOW_PRIVATE_UPSTREAM=false
